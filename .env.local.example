# Banco de dados
DATABASE_URL="file:./dev.db"

# Hotmart
HOTMART_CLIENT_ID=seu_client_id
HOTMART_CLIENT_SECRET=seu_client_secret
HOTMART_BASIC_TOKEN=Basic_seu_token_base64

# Facebook Marketing API
FACEBOOK_ACCESS_TOKEN=seu_token_de_acesso_longa_duracao
